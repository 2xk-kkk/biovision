# BioAgent 智能体环境变量
#
# 默认会回退到 backend/PPT/.env（那里已经有 DEEPSEEK_API_KEY），
# 想让智能体单独用一个 Key，就把本文件复制成 .env 并填上。
#
# 本文件里的变量优先级高于 backend/PPT/.env。

DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选：通义千问（阿里云百炼）
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# 默认模型：deepseek-chat / deepseek-reasoner / qwen-plus / gpt-4.1
# AGENT_DEFAULT_MODEL=deepseek-chat
